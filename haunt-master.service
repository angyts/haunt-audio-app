[Unit]
Description=Gui Gui Master Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=haunt-master
WorkingDirectory=/home/haunt-master/haunt/haunt-audio-app
EnvironmentFile=/home/haunt-master/haunt/haunt-audio-app/haunt.env
ExecStart=/home/haunt-master/haunt/haunt-audio-app/.venv/bin/python /home/haunt-master/haunt/haunt-audio-app/master.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
