[Unit]
Description=Gui Gui microphone voice mimic
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=haunt-mic
WorkingDirectory=/home/haunt-mic/haunt/haunt-audio-app
EnvironmentFile=/home/haunt-mic/haunt/haunt-audio-app/voice.env
ExecStart=/usr/bin/python3 /home/haunt-mic/haunt/haunt-audio-app/voice_sender.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
